{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guardGitWrite.mjs",
            "timeout": 10,
            "statusMessage": "Checking git write guard"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/guardRipgrepReplace.mjs",
            "timeout": 10,
            "statusMessage": "Checking ripgrep --replace guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/checkServerLogging.mjs",
            "timeout": 10,
            "statusMessage": "Checking server logging rule"
          }
        ]
      }
    ]
  }
}
