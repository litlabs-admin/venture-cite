# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URL of this app — used to build absolute links in transactional
# emails and in the Supabase verification-link `emailRedirectTo` so the
# verification link lands users back on /login?verified=1 instead of
# the Supabase project's default Site URL. In production set this to
# https://app.venturecite.com (or wherever the app is served).
APP_URL=http://localhost:5000

# NOTE: Email verification flow depends on the Supabase Dashboard
# settings — these aren't visible to the server:
#   1. Authentication → Providers → Email → "Confirm email" must be ON.
#      If OFF, Supabase auto-confirms accounts and our verification gate
#      is silently bypassed.
#   2. Authentication → URL Configuration → Site URL should be set to
#      the same APP_URL above (used as the fallback redirect for the
#      admin.createUser confirmation email — the admin API doesn't
#      accept emailRedirectTo, only resend() does).

# ─── Database (Supabase Postgres — use the pooled connection URL) ─
# Settings → Database → Connection string → "Transaction" pooler (port 6543)
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Replace <password> with the real password — do NOT keep the [] brackets from Supabase's template.
# Append ?sslmode=require so the Postgres protocol layer also enforces TLS.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ─── Postgres TLS hardening (recommended for production) ─────────
# Path to a PEM file containing the Supabase pooler root CA. Download from
# Supabase → Settings → Database → SSL configuration → Download cert.
# When set, the connection verifies the server's cert chain against this CA
# (strongly recommended for production). When unset, the connection is
# still TLS-encrypted but the chain isn't verified — fine for local dev.
DATABASE_CA_CERT_PATH=
# Alternatively, set this to "true" to verify against Node's default CA
# bundle (works for some hosted Postgres setups; usually fails for
# Supabase pooler — prefer DATABASE_CA_CERT_PATH).
DATABASE_SSL_REJECT_UNAUTHORIZED=

# ─── Supabase Auth (server — NEVER commit real values) ───────────
# Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Settings → API → Project API keys → service_role (server-only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role_key...

# ─── Supabase (browser — exposed to client via Vite) ─────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...anon_key...

# ─── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-side fallback read by server/stripeClient.ts before
# VITE_STRIPE_PUBLISHABLE_KEY. Rarely needed — leave unset and rely on
# VITE_STRIPE_PUBLISHABLE_KEY above unless you specifically need a
# server-only (non-Vite-bundled) copy of the publishable key.
STRIPE_PUBLISHABLE_KEY=

# ─── AI providers ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OpenRouter powers 4 of the 5 citation platforms (Claude, Gemini,
# Perplexity, DeepSeek). ChatGPT citations still use OPENAI_API_KEY.
# Without this key those 4 platforms are skipped gracefully.
OPENROUTER_API_KEY=sk-or-...

# ─── Email ───────────────────────────────────────────────────────
# Password reset is handled by Supabase Auth (magic link).
# Weekly AI visibility reports are sent via Resend — free tier: 3,000 emails/day.
# Leave blank to disable the weekly report cron entirely.
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=VentureCite <reports@venturecite.app>
# Optional cron override (default: Sunday 8:00 AM UTC)
WEEKLY_REPORT_CRON=0 8 * * 0

# ─── Buffer Social Publishing ────────────────────────────────────
# Users supply their own Buffer API key via the in-app Connect dialog
# (Buffer Settings → API: https://publish.buffer.com/settings/api). The
# server validates the key against Buffer's GraphQL API at
# https://api.buffer.com and stores it AES-256-GCM encrypted at rest
# using BUFFER_ENCRYPTION_KEY. Generate the encryption key with:
#   openssl rand -base64 32
# Rotating BUFFER_ENCRYPTION_KEY invalidates every stored Buffer key
# (users will need to re-connect Buffer). NEVER commit a real value.
BUFFER_ENCRYPTION_KEY=

# ─── Session / unsubscribe secrets ────────────────────────────────
# General-purpose secret. Currently only consumed as the fallback for
# EMAIL_UNSUBSCRIBE_SECRET below (server/lib/unsubscribeToken.ts) — set
# at least one of the two. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Signs the one-click unsubscribe tokens embedded in transactional
# emails (List-Unsubscribe header). Generate with:
#   openssl rand -base64 32
# Falls back to SESSION_SECRET if unset, but a dedicated key is safer.
EMAIL_UNSUBSCRIBE_SECRET=

# ─── Resend bounce / complaint webhook ───────────────────────────
# Configure a webhook in the Resend dashboard pointing at:
#   https://app.venturecite.app/api/webhooks/resend
# subscribed to email.bounced, email.complained, email.delivered.
# Copy the "Signing secret" (starts with "whsec_") here. When unset,
# the endpoint rejects all requests so a missing webhook integration
# can't be silently exploited.
RESEND_WEBHOOK_SECRET=

# Optional: pin the Stripe API version explicitly. When unset, the
# server falls back to a hardcoded version (see server/stripeClient.ts).
STRIPE_API_VERSION=

# ─── Observability (Sentry + log level) ──────────────────────────
# Both are optional — if SENTRY_DSN is unset, error capture is a no-op.
# https://sentry.io → Settings → Client Keys (DSN)
SENTRY_DSN=
# Browser-exposed Sentry DSN. Often the same project, sometimes a separate
# frontend project. Vite ships VITE_* values to the client bundle.
VITE_SENTRY_DSN=
# Tag events with environment (defaults to NODE_ENV if unset).
SENTRY_ENVIRONMENT=
# pino log level — fatal | error | warn | info | debug | trace | silent
# Defaults: debug (dev), info (prod).
LOG_LEVEL=

# ─── Reddit OAuth (Mentions feature) ─────────────────────────────
# Create a Reddit script app at https://www.reddit.com/prefs/apps; required for the Mentions feature.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ─── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (server/app.ts),
# added on top of APP_URL's own apex/www expansion. *.vercel.app preview
# deploys are already allowed automatically — this is for extra domains
# only (e.g. a second marketing site, a staging Render URL).
EXTRA_CORS_ORIGINS=

# ─── Cron / scheduled-job HTTP auth ───────────────────────────────
# Authenticates POST /api/cron/daily-orchestrator (server/routes/cron.ts).
# Accepted as either `Authorization: Bearer <CRON_SECRET>` (the header
# Vercel's own Cron Jobs product auto-injects) or `x-cron-secret: <value>`
# (for an external scheduler, or for triggering it on Render). The route
# fails closed — every request is rejected — if this is unset. Generate
# with: openssl rand -base64 32
CRON_SECRET=

# ─── In-process scheduler overrides (server/scheduler.ts) ────────
# Only meaningful on a long-lived process where nitroBoot runs
# initScheduler() — i.e. Render (NODE_ENV=production, VERCEL unset).
# On Vercel this scheduler never starts; leave these unset there.
# All are optional cron-expression overrides; each has a hardcoded
# default in server/scheduler.ts if unset.
# WEEKLY_REPORT_CRON is documented above, near RESEND_*.
AUTO_CITATION_CRON=
COMPETITOR_DISCOVERY_CRON=
MENTION_SCAN_CRON=
LISTICLE_SCAN_CRON=
ACCOUNT_PURGE_CRON=
BRAND_PURGE_CRON=
TOUR_EVENTS_CLEANUP_CRON=
DETECT_FACT_SCRAPE_FAILURE_CRON=
WEEKLY_CATCHUP_CRON=
# Per-user brand cap applied by the weekly report job. Default: 3.
WEEKLY_MAX_BRANDS_PER_USER=

# ─── Fact Agent v2 tuning flags (all optional) ────────────────────
# Jina Reader fallback for pages that resist the default scraper.
JINA_API_KEY=
FACT_AGENT_JINA_ENABLED=
# Overrides which model ranks candidate source URLs.
FACT_AGENT_LLM_URL_RANKER=
FACT_AGENT_WIKIDATA_ENABLED=

# ─── Vercel function budget (Vercel only) ─────────────────────────
# Drives every derived timeout in server/lib/factAgent/v2/vercelBudget.ts
# (LLM call timeout, SSE slice budget, cron-orchestrator step budgets).
# Defaults to 60000 (Pro-tier assumption) if unset. Set explicitly to
# 10000 on Vercel Hobby, or the orchestrator will assume it has 60s and
# get hard-killed by the platform partway through a step. Meaningless
# on Render (long-lived process, no per-request duration cap) — leave
# unset there.
VERCEL_FUNCTION_BUDGET_MS=

# ─── Sentry release / source maps (build-time, Vercel only in practice) ──
# Consumed by @sentry/vite-plugin during `vite build` (vite.config.ts) —
# only activates when SENTRY_AUTH_TOKEN is present. Local/Render builds
# without it still produce hidden .map files, just without upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Release identifier tag. vite.config.ts reads this directly (not
# auto-derived from VERCEL_GIT_COMMIT_SHA despite the env var's name
# suggesting it) — set explicitly if you want release tracking.
SENTRY_RELEASE=
# Client-side Sentry environment tag (separate from server-side
# SENTRY_ENVIRONMENT above) — read by client/src/lib/sentry.ts.
VITE_SENTRY_ENVIRONMENT=

# ─── Client feature flags (build-time) ────────────────────────────
VITE_TOUR_ENGINE_ENABLED=

# ─── Playwright end-to-end tests ──────────────────────────────────
# Playwright end-to-end tests. Must be a throwaway account — the suite
# creates and deletes records under it. Never point this at a real user.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
