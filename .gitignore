# ─── Dependencies ────────────────────────────────────────────────
node_modules
.pnp
.pnp.js

# ─── Build output ────────────────────────────────────────────────
dist
build
out
server/public
*.tsbuildinfo
# Nitro can create `.output` under the configured Vite root.
.output/

# ─── Environment variables - NEVER commit ───────────────────────
.env
.env.*
!.env.example

# ─── AI call log (no-op now but defensive) ───────────────────────
log.txt
*.log
logs/

# ─── Editor / IDE ────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~

# ─── Claude Code local state ─────────────────────────────────────
# `.claude/skills/` is GENERATED by `npm run skills:setup` from
# `.agents/project-skills.json`. This machine runs core.symlinks=false, so a
# committed symlink checks out as a plain text file. Track the source and the
# script instead. `.claude/settings.json` and `.claude/launch.json` ARE tracked.
.claude/skills/
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock

# ─── OS cruft ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Temp / misc ─────────────────────────────────────────────────
*.tar.gz
*.zip
*.tmp
*.bak
*.orig
tmp/
temp/
coverage/
.nyc_output/
.cache/
.turbo/
.next/
.vercel/

# ─── Playwright e2e output - includes .auth/state.json, a real ──
# ─── session token; must never be committed ─────────────────────
test-results/
playwright-report/
blob-report/

# ─── Playwright shared e2e auth state - playwright/.auth/state.json ────
# ─── holds a real Supabase session token; must never be committed ──────
playwright/.auth/

# ─── Runtime ─────────────────────────────────────────────────────
pids
*.pid
*.seed
*.pid.lock

# ─── Package managers ────────────────────────────────────────────
.npm
.yarn-integrity
yarn-error.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── Drizzle ─────────────────────────────────────────────────────
drizzle/meta/

# ─── Vite HMR / local config overrides ──────────────────────────
vite.config.ts.*
vite.config.js.*

# ─── graphify knowledge-graph output (do not track) ──────────
graphify-out/

# ─── Stale Replit artifacts (should already be deleted) ────────
.replit
replit.nix
attached_assets/
.VSCodeCounter/
brainstorms/
# Track project skills and shared Codex configuration.
# Keep local Codex state and overrides outside Git.
.codex/*.local.toml
.codex/state/
# Office documents - scripts, decks and sheets are working material,
# and a binary blob in git diffs as one unreadable line anyway.
*.docx
*.doc
*.pptx
*.xlsx

# Vercel build output (generated server bundle, not source)
api/

# Local secret drops (webhook signing secrets etc) - never commit these
*.local.txt
.vercel

# Supabase CLI local state. `.temp/start-secrets/` holds SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_INTERNAL_JWT_SECRET and a pooler URL with the DB password in it, and
# `.branches/` is per-machine. These are local CLI artifacts, never source.
supabase/.temp/
supabase/.branches/

# ── Agent tooling (added 2026-08-27) ─────────────────────────────────
# Skill packages installed via `npx skills add`, restorable from skills-lock.json
# with `npx skills experimental_install`.
#
# These are listed INDIVIDUALLY and deliberately. `.agents/skills/` as a whole must
# NOT be ignored: it already contains 20 tracked, hand-maintained skills (architect,
# tdd, unslop, the principle-* set, ...) across 79 tracked files. Ignoring the
# directory would not untrack them - it would only hide future edits to them from
# `git status`, which is worse than the noise it removes.
#
# When adding a skill package, add its directory here explicitly.
.agents/skills/brainstorming/
.agents/skills/dispatching-parallel-agents/
.agents/skills/executing-plans/
.agents/skills/finishing-a-development-branch/
.agents/skills/receiving-code-review/
.agents/skills/requesting-code-review/
.agents/skills/subagent-driven-development/
.agents/skills/systematic-debugging/
.agents/skills/test-driven-development/
.agents/skills/using-git-worktrees/
.agents/skills/using-superpowers/
.agents/skills/verification-before-completion/
.agents/skills/writing-plans/
.agents/skills/writing-skills/

# Subagent-driven-development scratch: ledgers, briefs, review packages,
# diffs and JSON schemas for in-flight plans.
.superpowers/

# Config backups taken before the 2026-08-27 Codex repair.
*.bak-20260827
.codex/agents.bak-*/

# Raw Codex transcripts from the B1p audit fan-out. Tens of megabytes, and the
# reports and register in .audit/B1p/ carry everything worth keeping.
.audit/B1p/logs/
