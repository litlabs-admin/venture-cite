# ─── Dependencies ────────────────────────────────────────────────
node_modules
.pnp
.pnp.js

# ─── Build output ────────────────────────────────────────────────
dist
build
out
server/public
*.tsbuildinfo
# Nitro's own build output (TanStack Start). Lands under client/ today
# because Nitro resolves it relative to Vite's `root`, not the repo root -
# see the Phase 2 Task 2 report for why that's a live, unresolved conflict
# with the existing `build.outDir: dist/public` convention.
.output/

# ─── Environment variables - NEVER commit ───────────────────────
.env
.env.*
!.env.example

# ─── AI call log (no-op now but defensive) ───────────────────────
log.txt
*.log
logs/

# ─── Documentation / notes - kept local, never pushed ──────────
*.md
!README.md
!docs/privacy-policy.md
!docs/phase1_goals.md
!docs/phase1_completion.md
!docs/phase2_goals.md
!docs/phase2_completion.md
# Operational, not notes - needed by anyone deploying this.
!docs/deploy-runbook.md

# ─── Editor / IDE ────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~

# ─── Claude Code local state ─────────────────────────────────────
.claude

# ─── OS cruft ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Temp / misc ─────────────────────────────────────────────────
*.tar.gz
*.zip
*.tmp
*.bak
*.orig
tmp/
temp/
coverage/
.nyc_output/
.cache/
.turbo/
.next/
.vercel/

# ─── Playwright e2e output - includes .auth/state.json, a real ──
# ─── session token; must never be committed ─────────────────────
test-results/
playwright-report/
blob-report/

# ─── Playwright shared e2e auth state - playwright/.auth/state.json ────
# ─── holds a real Supabase session token; must never be committed ──────
playwright/.auth/

# ─── Runtime ─────────────────────────────────────────────────────
pids
*.pid
*.seed
*.pid.lock

# ─── Package managers ────────────────────────────────────────────
.npm
.yarn-integrity
yarn-error.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── Drizzle ─────────────────────────────────────────────────────
drizzle/meta/

# ─── Vite HMR / local config overrides ──────────────────────────
vite.config.ts.*
vite.config.js.*

# ─── graphify knowledge-graph output (do not track) ──────────
graphify-out/

# ─── Stale Replit artifacts (should already be deleted) ────────
.replit
replit.nix
attached_assets/
.VSCodeCounter/
brainstorms/
.agents/
.codex/
# Office documents - scripts, decks and sheets are working material,
# and a binary blob in git diffs as one unreadable line anyway.
*.docx
*.doc
*.pptx
*.xlsx

# Superpowers specs, plans and baselines stay LOCAL - they fall under the
# global *.md ignore above. The handful already committed stay tracked;
# git does not untrack a file just because it becomes ignored.

# Vercel build output (generated server bundle, not source)
api/
